# Caddy — TLS-терминатор на краю стека (авто Let's Encrypt + автопродление).
#
# Почти весь трафик уходит в frontend-контейнер, чей внутренний nginx
# отдаёт SPA, проксирует /api/* в backend и держит rate-limit на /auth/*.
# Мимо него идут только адреса для внешних ИИ-ассистентов: MCP-сервер и
# метаданные OAuth (см. блок anfinances.ru ниже).
#
# Порт 443 занимал VPN, поэтому сайт временно жил на 8443. VPN ушёл,
# и Caddy вернулся на 443.
#
# Продление сертификата держится на двух вещах, и обе легко сломать
# незаметно (11.08.2026 они были сломаны обе сразу):
#
#   1. Домен смотрит прямо на сервер, без прокси-посредника. Пока
#      перед ним стоял Cloudflare, Let's Encrypt приходил на адрес
#      Cloudflare, и TLS-ALPN до сервера не добирался. Сейчас домен
#      делегирован на Beget и A-записи ведут на 188.68.49.26.
#   2. Порт 80 открыт в ufw, а системный nginx отдаёт
#      /.well-known/acme-challenge/ в этот Caddy на 127.0.0.1:8080
#      (см. /etc/nginx/sites-enabled/anfinances.conf на сервере).
#      Раньше nginx искал челлендж в /var/www/html — каталоге для
#      certbot, которого на сервере нет, — и отвечал 404.
#
# Проверка, что путь жив: сертификат на www.anfinances.ru выписан
# 11.08.2026, уже после починки.
#
# Адрес для уведомлений Let's Encrypt задаётся переменной ACME_EMAIL
# (GitHub Secret). Без неё Caddy работает так же, просто не пришлёт
# письмо, если продление вдруг сломается.

{
	http_port 80
}

anfinances.ru {
	# HSTS — на этом контуре TLS уже есть (на http-контуре его не было).
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# MCP-сервер для ChatGPT, Claude и Claude Code. Отдельный контейнер,
	# а не путь в nginx фронта: ответ не проходит лишний прокси.
	# flush_interval -1 — ответ уходит клиенту сразу, без буфера: в
	# Streamable HTTP сервер вправе отвечать потоком событий, и
	# буферизованный поток выглядит для клиента как зависание. Сжатия
	# здесь нет по той же причине.
	handle /mcp* {
		reverse_proxy mcp:8100 {
			flush_interval -1
		}
	}

	# Метаданные защищённого ресурса (RFC 9728): по ним клиент узнаёт,
	# кто выдаёт токены. Отдаёт их сам MCP-сервер.
	handle /.well-known/oauth-protected-resource* {
		reverse_proxy mcp:8100
	}

	# Метаданные сервера авторизации (RFC 8414) живут в backend, но по
	# корневому пути — /api их не покрывает. OIDC-адрес тоже в backend:
	# иначе SPA ответила бы на него страницей с кодом 200, и клиент,
	# перебирающий адреса, споткнулся бы о HTML вместо 404.
	handle /.well-known/oauth-authorization-server* {
		reverse_proxy backend:8000
	}
	handle /.well-known/openid-configuration* {
		reverse_proxy backend:8000
	}

	handle {
		encode zstd gzip
		reverse_proxy frontend:80
	}
}

www.anfinances.ru {
	redir https://anfinances.ru{uri} permanent
}

# Старый адрес сайта. Оставлен, чтобы уже открытые вкладки и
# закладки не упёрлись в пустоту; уберётся вместе с публикацией
# порта 8443 в compose.
anfinances.ru:8443 {
	redir https://anfinances.ru{uri} permanent
}
