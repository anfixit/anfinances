# Caddy — TLS-терминатор на краю стека (авто Let's Encrypt + автопродление).
#
# Проксирует ВЕСЬ трафик в frontend-контейнер, чей внутренний nginx уже
# отдаёт SPA, проксирует /api/* в backend и держит rate-limit на /auth/*.
#
# Порт 443 занимал VPN, поэтому сайт временно жил на 8443 и брал
# сертификат только HTTP-челленджем. VPN ушёл, 443 свободен: Caddy
# вернулся на него и снова умеет TLS-ALPN, так что продление больше
# не зависит от системного nginx на 80.
#
# Адрес для уведомлений Let's Encrypt задаётся переменной ACME_EMAIL
# (GitHub Secret). Без неё Caddy работает так же, просто не пришлёт
# письмо, если продление вдруг сломается.

{
	http_port 80
}

anfinances.ru {
	encode zstd gzip

	# HSTS — на этом контуре TLS уже есть (на http-контуре его не было).
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	reverse_proxy frontend:80
}

www.anfinances.ru {
	redir https://anfinances.ru{uri} permanent
}

# Старый адрес сайта. Оставлен, чтобы уже открытые вкладки и
# закладки не упёрлись в пустоту; уберётся вместе с публикацией
# порта 8443 в compose.
anfinances.ru:8443 {
	redir https://anfinances.ru{uri} permanent
}
